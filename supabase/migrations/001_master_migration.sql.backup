-- ============================================================================
-- MIGRACIÓN MAESTRA PARA SISTEMA DE 3 ROLES DE CASA LATINA PING PONG CLUB
-- ============================================================================
-- Este archivo combina TODAS las migraciones en el orden correcto de ejecución
-- Ejecutar este archivo PRIMERO aplicará todas las actualizaciones necesarias
--
-- Autor: Claude Code Assistant
-- Fecha: 2026-02-13
-- Descripción: Sistema completo de gestión de club con 3 roles jerárquicos
-- ============================================================================

SET statement_timeout = 0; -- Desactiva timeout para ejecución segura

-- ============================================================================
-- TABLA 1: profiles - ACTUALIZAR CON EXTENDED_ROLE
-- ============================================================================
-- Agrega campo extended_role para soportar 4 roles: admin, leader, member, guest
-- ============================================================================
DO $$
ALTER TABLE profiles ADD COLUMN IF NOT EXISTS extended_role text;
$$

-- Migrar datos existentes de role a extended_role
UPDATE profiles
SET extended_role = CASE
  WHEN role = 'admin' THEN 'admin'::text
  WHEN role = 'member' THEN 'member'::text
  ELSE role::text
END::text;

-- Crear índice para rendimiento
CREATE INDEX IF NOT EXISTS profiles_extended_role_idx ON profiles (extended_role);
$$

-- ============================================================================
-- TABLA 2: club_info - INFORMACIÓN DEL NEGOCIO
-- ============================================================================
-- Almacena información del club que solo admin puede editar
-- ============================================================================
DO $$
CREATE TABLE IF NOT EXISTS club_info (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  key text UNIQUE NOT NULL,
  value text NOT NULL,
  updated_at timestamptz DEFAULT now()
);
$$

-- Políticas RLS
ALTER TABLE club_info ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Club info viewable by everyone"
ON club_info FOR SELECT
USING (true);
$$

CREATE POLICY "Admins can manage club info"
ON club_info FOR ALL
USING (EXISTS (
  SELECT 1 FROM profiles WHERE extended_role = 'admin'::text
  WITH CHECK OPTION (auth.uid() = id)
);
$$

-- Datos semilla
INSERT INTO club_info (key, value) VALUES
  ('description', '"es": {"title": "Club de Ping Pong", "subtitle": "Donde el ping pong se encuentra con la cultura, la música y el arte"}'),
