-- Insert initial club info (can be updated by admin)
INSERT INTO club_info (key, value) VALUES
('description', '{"es": "Bienvenido a Casa Latina Ping Pong Club, el lugar de encuentro para los amantes del tenis de mesa en San Cristóbal de las Casas, Chiapas. Nuestro club ofrece entrenamientos, torneos, eventos sociales y una comunidad apasionada por este deporte.", "en": "Welcome to Casa Latina Ping Pong Club..."}}'),
('schedule', '{"es": {"lunes_a_viernes": "18:00 - 21:00", "sabado": "10:00 - 14:00", "domingo": "Cerrado", "notas": "Horarios sujetos a cambios según temporada"}}'),
('contact', '{"telefono": "+52 967 123 4567", "whatsapp": "+52 967 123 4567", "email": "info@casalatinappong.com", "facebook": "CasalatinaPingPong", "instagram": "@casalatina.pingpong"}}'),
('pricing', '{"es": {"mensual": "$200 MXN", "trimestral": "$500 MXN", "anual": "$1,500 MXN", "dia_evento": "$50 MXN", "notas": "Precios sujetos a cambios sin previo aviso"}}')
