-- Migration 007: Update RLS policies to support leader role
-- This updates existing policies to allow both admins and leaders to manage most content

-- Drop old policies for events (will recreate with leader access)
DROP POLICY IF EXISTS "Admins can insert events" ON events;
DROP POLICY IF EXISTS "Admins can update events" ON events;
DROP POLICY IF EXISTS "Admins can delete events" ON events;

-- Recreate event policies with admin and leader access
CREATE POLICY "Admins and leaders can insert events"
ON events FOR INSERT
TO authenticated
WITH CHECK (
  EXISTS (
    SELECT 1 FROM profiles
    WHERE profiles.id = auth.uid()
    AND profiles.extended_role IN ('admin', 'leader')
  )
);

CREATE POLICY "Admins and leaders can update events"
ON events FOR UPDATE
TO authenticated
USING (
  EXISTS (
    SELECT 1 FROM profiles
    WHERE profiles.id = auth.uid()
    AND profiles.extended_role IN ('admin', 'leader')
  )
)
WITH CHECK (
  EXISTS (
    SELECT 1 FROM profiles
    WHERE profiles.id = auth.uid()
    AND profiles.extended_role IN ('admin', 'leader')
  )
);

CREATE POLICY "Admins and leaders can delete events"
ON events FOR DELETE
TO authenticated
USING (
  EXISTS (
    SELECT 1 FROM profiles
    WHERE profiles.id = auth.uid()
    AND profiles.extended_role IN ('admin', 'leader')
  )
);

