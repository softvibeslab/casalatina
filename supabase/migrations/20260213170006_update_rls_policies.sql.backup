-- Update member update policies to allow leaders
DROP POLICY IF EXISTS "Admins can update any membership" ON members;

CREATE POLICY "Admins and leaders can update any membership"
ON members FOR UPDATE
TO authenticated
USING (
  EXISTS (
    SELECT 1 FROM profiles
    WHERE profiles.id = auth.uid()
    AND profiles.extended_role IN ('admin', 'leader')
  )
)
WITH CHECK (
  EXISTS (
    SELECT 1 FROM profiles
    WHERE profiles.id = auth.uid()
    AND profiles.extended_role IN ('admin', 'leader')
  )
);

-- Allow admins and leaders to update member XP and level
CREATE POLICY "Admins and leaders can update member xp and level"
ON members FOR UPDATE
TO authenticated
USING (
  EXISTS (
    SELECT 1 FROM profiles
    WHERE profiles.id = auth.uid()
    AND profiles.extended_role IN ('admin', 'leader')
  )
)
WITH CHECK (
  EXISTS (
    SELECT 1 FROM profiles
    WHERE profiles.id = auth.uid()
    AND profiles.extended_role IN ('admin', 'leader')
  )
);

-- Add comment documenting the policy updates
COMMENT ON POLICY "Admins and leaders can insert events" ON events IS 'Allows both admins and leaders to create events. Leaders cannot manage club info.';
COMMENT ON POLICY "Admins and leaders can insert tournaments" ON tournaments IS 'Allows both admins and leaders to create tournaments.';
