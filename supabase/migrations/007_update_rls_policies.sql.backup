-- Descripción: Actualiza políticas RLS para que admin y líder puedan gestionar el sistema
-- Orden: 7
-- ============================================================================

-- Actualizar política de member_levels para admin + líder
DROP POLICY IF EXISTS "Admins can manage levels" ON member_levels;
CREATE POLICY "Admins and leaders can manage levels"
ON member_levels FOR ALL
USING (auth.uid() IN (SELECT id FROM profiles WHERE extended_role IN ('admin', 'leader')))
WITH CHECK (auth.uid() IN (SELECT id FROM profiles WHERE extended_role IN ('admin', 'leader')));

-- Actualizar política de achievements para admin + líder
DROP POLICY IF EXISTS "Admins can manage achievements" ON achievements;
CREATE POLICY "Admins and leaders can manage achievements"
ON achievements FOR ALL
USING (auth.uid() IN (SELECT id FROM profiles WHERE extended_role IN ('admin', 'leader')))
WITH CHECK (auth.uid() IN (SELECT id FROM profiles WHERE extended_role IN ('admin', 'leader')));

-- Actualizar política de registrations para admin + líder
DROP POLICY IF EXISTS "Users can register themselves" ON registrations;

-- Nueva política para que admin + líder puedan gestionar inscripciones
CREATE POLICY "Admins and leaders can manage registrations"
ON registrations FOR ALL
USING (auth.uid() IN (SELECT id FROM profiles WHERE extended_role IN ('admin', 'leader')))
WITH CHECK (auth.uid() IN (SELECT id FROM profiles WHERE extended_role IN ('admin', 'leader')));
